// Cloudflare Workers config for printyours. Vercel ignores this file; see
// CLOUDFLARE.md for setup, and cloudflare/worker.js for how requests route.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "printyours",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  // Buffer and process.env, which the api/ functions use, plus Stripe's SDK.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Pages and files are served straight from the edge; only the API wakes the Worker.
    "run_worker_first": ["/api/*"]
  },
  // Sticker print files and quote attachments (Vercel Blob's job on Vercel).
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "printyours-uploads" }],
  // AI sticker art on /stickers (cloudflare/sticker-ai.js), and its daily limits.
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "AI_LIMITS", "id": "1d97c22d17824be8b483fa63c36273e7" }],
  "vars": {
    "AI_PER_VISITOR": "5",
    "AI_PER_DAY": "60"
  },
  // The api/ files import Vercel Blob; on Cloudflare they get R2 instead.
  "alias": {
    "@vercel/blob/client": "./cloudflare/blob-r2.js",
    "@vercel/blob": "./cloudflare/blob-r2.js"
  },
  "observability": { "enabled": true }
}
